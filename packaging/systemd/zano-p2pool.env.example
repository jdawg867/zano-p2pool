# Copy to /etc/zano-p2pool/zano-p2pool.env, replace the wallet address, and
# adjust binds only for interfaces protected by the host firewall.
ZANO_P2POOL_NETWORK=testnet
ZANO_P2POOL_WALLET=REPLACE_WITH_A_STANDARD_TESTNET_ZANO_ADDRESS
ZANO_P2POOL_RPC_URL=http://127.0.0.1:12111/json_rpc
ZANO_P2POOL_STRATUM_BIND=127.0.0.1
ZANO_P2POOL_STRATUM_PORT=3333
ZANO_P2POOL_P2P_BIND=127.0.0.1
ZANO_P2POOL_P2P_PORT=37888
ZANO_P2POOL_METRICS_BIND=127.0.0.1
ZANO_P2POOL_METRICS_PORT=37890
